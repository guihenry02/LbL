{
  "manifest_version": 3,
  "name": "Language Learning",
  "description": "Browser extension for language learning.",
  "version": "0.0.1",

  "permissions": ["storage"],

  "host_permissions": [
    "http://localhost:8081/*",
    "file:///*"
  ],

  "background": {
    "scripts": ["src/background/main.js"]
  },

  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*", "file:///*"],
      "js": ["src/content/main.js"],
      "all_frames": true
    }
  ],

  "action": {
    "default_title": "Language Learning",
    "default_popup": "index.html"
  }
}